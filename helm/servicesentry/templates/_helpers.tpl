{{/* Expand the name of the chart. */}}
{{- define "servicesentry.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{/* Fully qualified app name. */}}
{{- define "servicesentry.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- $name := default .Chart.Name .Values.nameOverride -}}
{{- if contains $name .Release.Name -}}
{{- .Release.Name | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}
{{- end -}}

{{/* Common labels. */}}
{{- define "servicesentry.labels" -}}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{ include "servicesentry.selectorLabels" . }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
{{- if .Chart.AppVersion }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
{{- end }}
{{- end -}}

{{/* Selector labels. */}}
{{- define "servicesentry.selectorLabels" -}}
app.kubernetes.io/name: {{ include "servicesentry.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end -}}

{{/* Secret name (generated or external). */}}
{{- define "servicesentry.secretName" -}}
{{- if .Values.existingSecret -}}{{ .Values.existingSecret }}{{- else -}}{{ include "servicesentry.fullname" . }}-secret{{- end -}}
{{- end -}}

{{/* ServiceAccount name. */}}
{{- define "servicesentry.serviceAccountName" -}}
{{- if .Values.serviceAccount.create -}}
{{- default (include "servicesentry.fullname" .) .Values.serviceAccount.name -}}
{{- else -}}
{{- default "default" .Values.serviceAccount.name -}}
{{- end -}}
{{- end -}}

{{/* envFrom block shared by every role (ConfigMap + Secret). */}}
{{- define "servicesentry.envFrom" -}}
- configMapRef:
    name: {{ include "servicesentry.fullname" . }}-env
- secretRef:
    name: {{ include "servicesentry.secretName" . }}
{{- end -}}

{{/* Shared volumes: the encryption key (same on every pod) + the var dir. The var dir
     holds backups, uploaded pictures, MIBs and SNMP profiles: on an emptyDir (the default,
     kept so an upgrade changes nothing) they die with the pod and no two pods see the same
     files; persistence.enabled mounts ONE claim on every pod instead. */}}
{{- define "servicesentry.volumes" -}}
- name: flasksecret
  secret:
    secretName: {{ include "servicesentry.fullname" . }}-secretkey
    items:
      - { key: flask_secret, path: .flask_secret }
- name: vardata
{{- if .Values.persistence.enabled }}
  persistentVolumeClaim:
    claimName: {{ include "servicesentry.varClaimName" . }}
{{- else }}
  emptyDir: {}
{{- end }}
{{- end -}}

{{/* The var-dir claim: an existing one, or the one templates/pvc.yaml creates. */}}
{{- define "servicesentry.varClaimName" -}}
{{- default (printf "%s-var" (include "servicesentry.fullname" .)) .Values.persistence.existingClaim -}}
{{- end -}}

{{- define "servicesentry.volumeMounts" -}}
- name: flasksecret
  mountPath: /etc/ServiSesentry/.flask_secret
  subPath: .flask_secret
  readOnly: true
- name: vardata
  mountPath: /var/lib/ServiSesentry
{{- end -}}

{{/* Whether the dedicated services open their control listener: control is on and a token
     reaches them — set in values, or generated by this chart's own Secret. With an
     existingSecret and no token in values the chart cannot know, so it does not probe a
     port that may never open. Renders "true" or nothing. */}}
{{- define "servicesentry.controlListens" -}}
{{- if and .Values.control.enabled (or .Values.control.token (not .Values.existingSecret)) -}}true{{- end -}}
{{- end }}

{{/* Control-listener container port + advertise env for a dedicated role.
     Usage: {{ include "servicesentry.controlEnv" (dict "ctx" $ "role" "worker") }} */}}
{{- define "servicesentry.controlEnv" -}}
{{- if .ctx.Values.control.enabled }}
- name: SS_CONTROL_ADVERTISE
  value: {{ printf "%s-%s" (include "servicesentry.fullname" .ctx) .role | quote }}
{{- end }}
{{- end -}}

{{/* The var dir is shared by every role once persistence is on, and two of the roles write
     to it as root: worker (raw ICMP for ping) and syslog (:514) — while web and events run
     as podSecurityContext.runAsUser (1000). fsGroup is not honoured by NFS and most RWX
     drivers, so files and directories root created (the compiled MIBs, the monitor's state)
     were left root:root 0755 and the web pods could not write into them. With persistence
     on, these root roles therefore:
       - run with the same primary group as the others, and umask 0002, so what they create
         is group-writable by the non-root pods (they stay root: the capabilities they need
         are not granted to a non-root process by Kubernetes);
       - hand the claim to that uid/gid in an init container, which repairs what an earlier
         version left behind. On NFS with root_squash the chown is refused; the pod starts
         anyway and docs/caso-kubernetes.md says how to export the share.
     Off (persistence.enabled=false or persistence.fixOwnership=false) nothing changes. */}}
{{- define "servicesentry.varOwnerOn" -}}
{{- if and .Values.persistence.enabled .Values.persistence.fixOwnership -}}true{{- end -}}
{{- end -}}

{{- define "servicesentry.varUid" -}}
{{- default 1000 .Values.podSecurityContext.runAsUser -}}
{{- end -}}

{{- define "servicesentry.varGid" -}}
{{- default 1000 (default .Values.podSecurityContext.runAsGroup .Values.podSecurityContext.fsGroup) -}}
{{- end -}}

{{/* Pod-level: the group the claim is shared through. */}}
{{- define "servicesentry.rootRolePodSecurity" -}}
{{- if include "servicesentry.varOwnerOn" . }}
securityContext:
  fsGroup: {{ include "servicesentry.varGid" . }}
  fsGroupChangePolicy: OnRootMismatch
{{- end }}
{{- end -}}

{{/* The init container that gives the claim to the non-root uid/gid. */}}
{{- define "servicesentry.varOwnerInit" -}}
{{- if include "servicesentry.varOwnerOn" . }}
initContainers:
  - name: var-owner
    image: "{{ .Values.image.repository }}:{{ .Values.image.tag }}"
    imagePullPolicy: {{ .Values.image.pullPolicy }}
    securityContext:
      runAsUser: 0
    command:
      - /bin/sh
      - -c
      - >-
        chown -R {{ include "servicesentry.varUid" . }}:{{ include "servicesentry.varGid" . }} /var/lib/ServiSesentry
        && chmod -R ug+rwX /var/lib/ServiSesentry
        || echo "var-owner: could not hand /var/lib/ServiSesentry to {{ include "servicesentry.varUid" . }}:{{ include "servicesentry.varGid" . }} (NFS root_squash?)" >&2
    volumeMounts:
      - name: vardata
        mountPath: /var/lib/ServiSesentry
{{- end }}
{{- end -}}

{{/* Container-level, for the root roles: the shared group and a umask that keeps it
     writable. `command` wraps the image's entrypoint only to set the umask; the role is
     still chosen by SS_SERVICE_ROLE. */}}
{{- define "servicesentry.rootRoleContainer" -}}
{{- if include "servicesentry.varOwnerOn" . }}
command: ["/bin/sh", "-c", "umask 0002 && exec /entrypoint.sh"]
{{- end }}
{{- end -}}

{{/* securityContext of a root role's container: NET_RAW (raw ICMP for the ping module) when
     asked for (worker, and only with .Values.netRaw), and the
     shared primary group when the var claim is shared.
     Usage: {{ include "servicesentry.rootRoleSecurity" (dict "ctx" $ "netRaw" true) }} */}}
{{- define "servicesentry.rootRoleSecurity" -}}
{{- $raw := and .netRaw .ctx.Values.netRaw -}}
{{- $grp := include "servicesentry.varOwnerOn" .ctx -}}
{{- if or $raw $grp }}
securityContext:
  {{- if $grp }}
  runAsGroup: {{ include "servicesentry.varGid" .ctx }}
  {{- end }}
  {{- if $raw }}
  capabilities:
    add: ["NET_RAW"]
  {{- end }}
{{- end }}
{{- end -}}
