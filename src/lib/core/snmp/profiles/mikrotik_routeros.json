{
  "id": "mikrotik_routeros",
  "label": {
    "en_EN": "MikroTik RouterOS",
    "es_ES": "MikroTik RouterOS"
  },
  "description": {
    "en_EN": "What a RouterOS device knows about its own hardware: temperatures, input voltage, power and current, fans and power supplies, the RouterOS and RouterBOOT it runs, its SFP modules and its PoE ports. Interfaces, filesystems and memory are standard MIBs and belong to the generic profiles.",
    "es_ES": "Lo que un equipo con RouterOS sabe de su propio hardware: temperaturas, tensión de entrada, potencia y corriente, ventiladores y fuentes, el RouterOS y el RouterBOOT que corre, sus módulos SFP y sus puertos PoE. Interfaces, sistemas de ficheros y memoria son MIBs estándar y son de los perfiles genéricos."
  },
  "match": {
    "sysobjectid_prefix": "1.3.6.1.4.1.14988",
    "probe": "1.3.6.1.4.1.14988.1.1.7.3.0"
  },
