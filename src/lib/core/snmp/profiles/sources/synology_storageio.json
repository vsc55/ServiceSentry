{
    "id": "synology_storageio",
    "label": {
        "en_EN": "Synology — disk I/O (SYNOLOGY-STORAGEIO-MIB)",
        "es_ES": "Synology — E/S de disco (SYNOLOGY-STORAGEIO-MIB)"
    },
    "description": {
        "en_EN": "Per physical disk: bytes and operations per second from the 64-bit counters, plus the utilisation the DiskStation itself computes. Replaces the generic UCD disk-I/O profile on a Synology — it runs net-snmp underneath, so both would answer and every disk would be charted twice.",
        "es_ES": "Por disco físico: bytes y operaciones por segundo desde los contadores de 64 bits, más la utilización que calcula el propio DiskStation. Sustituye al perfil genérico de E/S de UCD en un Synology — por debajo corre net-snmp, así que contestarían los dos y cada disco se graficaría dos veces."
    },
    "match": {
        "sysobjectid_prefix": "1.3.6.1.4.1.6574",
        "probe": "1.3.6.1.4.1.6574.101.1.1.1.0",
        "supersedes": ["disk_io"]
    },
    "metrics": [
        {
            "key": "syno_io_read",
            "label": {"en_EN": "Read", "es_ES": "Lectura"},
            "walk": "1.3.6.1.4.1.6574.101.1.1.12",
            "kind": "counter",
            "unit": "B/s",
            "width": 64,
            "chart": "area",
            "index_label": "1.3.6.1.4.1.6574.101.1.1.2"
        },
        {
            "key": "syno_io_write",
            "label": {"en_EN": "Written", "es_ES": "Escritura"},
            "walk": "1.3.6.1.4.1.6574.101.1.1.13",
            "kind": "counter",
            "unit": "B/s",
            "width": 64,
            "chart": "area",
            "index_label": "1.3.6.1.4.1.6574.101.1.1.2"
        },
        {
            "key": "syno_io_reads",
            "label": {"en_EN": "Read operations", "es_ES": "Operaciones de lectura"},
            "walk": "1.3.6.1.4.1.6574.101.1.1.15",
            "kind": "counter",
            "unit": "op/s",
            "width": 64,
            "index_label": "1.3.6.1.4.1.6574.101.1.1.2"
        },
        {
            "key": "syno_io_writes",
            "label": {"en_EN": "Write operations", "es_ES": "Operaciones de escritura"},
            "walk": "1.3.6.1.4.1.6574.101.1.1.16",
            "kind": "counter",
            "unit": "op/s",
