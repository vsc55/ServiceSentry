{
  "id": "windows_server_lm",
  "label": {
    "en_EN": "Windows server service",
    "es_ES": "Servicio de servidor de Windows"
  },
  "description": {
    "en_EN": "What a Windows serving files, printers or logons is doing: open sessions, users and shares, bytes in and out of the SMB stack, print queues, and the three kinds of error that say somebody is being refused — bad password, no permission, and system errors.",
    "es_ES": "Lo que hace un Windows que sirve ficheros, impresoras o autenticacion: sesiones abiertas, usuarios y recursos compartidos, bytes que entran y salen de la pila SMB, colas de impresion, y los tres tipos de error que dicen que a alguien se le esta negando algo: contrasena mala, sin permiso, y errores de sistema."
  },
  "match": {
    "sysobjectid_prefix": "1.3.6.1.4.1.311.1.1.3.1.2",
    "probe": "1.3.6.1.4.1.77.1.2.19.0"
  },
