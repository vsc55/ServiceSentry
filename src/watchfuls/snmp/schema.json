{
    "__icon__": "bi-hdd-stack",
    "__page__": {
        "id": "snmp", "icon": "bi-hdd-stack", "order": 25,
        "placement": "system", "perm": "modules_view",
        "render": "renderSnmpMibsPage",
        "views": [
            {"slug": "library", "icon": "bi-hdd-stack", "label": "view_mibs"},
            {"slug": "import", "icon": "bi-cloud-download", "label": "view_import"},
            {"slug": "compile", "icon": "bi-gear", "label": "view_compile"},
            {"slug": "browser", "icon": "bi-diagram-3", "label": "view_browser"},
            {"slug": "profiles", "icon": "bi-grid-3x3-gap", "label": "view_profiles"}
        ]
    },
    "__module__": {
        "api_ver": "v1",
        "enabled":  {"type": "bool", "default": true},
        "threads":  {"type": "int",  "default": 5, "min": 0, "inherit_blank": true, "max": 50},
        "mib_dirs": {"type": "str",  "default": ""},
        "mib_repos": {"type": "str", "default": "", "hidden": true},
        "github_token": {"type": "str", "default": "", "secret": true}
    },
    "__history__": {"field": null, "unit": null, "label": "SNMP Check"},
    "__backup_part__": {"id": "mibs", "dir": "snmp_mibs/raw",
                        "label_key": "backup_part_mibs", "default": false},
    "__host_profile__": {"key": "snmp", "address_field": "host",
                         "fields": ["host", "port",
                                    "version", "community",
                                    "snmpv3_username", "snmpv3_auth_key", "snmpv3_priv_key",
                                    "snmpv3_auth_protocol", "snmpv3_priv_protocol",
                                    "device_profiles"]},
    "__credential__": {
        "type": "snmp_auth",
        "fields": [
            {"name": "version", "kind": "select", "default": "2c", "options": ["1", "2c", "3"]},

            {"name": "community", "kind": "password", "secret": true,
             "show_when": {"version": ["1", "2c"]}},

            {"name": "snmpv3_level", "kind": "select", "default": "authPriv",
             "options": ["noAuthNoPriv", "authNoPriv", "authPriv"],
             "show_when": {"version": ["3"]}},
            {"name": "snmpv3_username", "kind": "text",
             "show_when": {"version": ["3"]}},

            {"name": "snmpv3_auth_protocol", "kind": "select", "default": "SHA",
             "options": ["MD5", "SHA", "SHA-224", "SHA-256", "SHA-384", "SHA-512"],
             "show_when": {"version": ["3"], "snmpv3_level": ["authNoPriv", "authPriv"]}},
            {"name": "snmpv3_auth_key", "kind": "password", "secret": true,
             "show_when": {"version": ["3"], "snmpv3_level": ["authNoPriv", "authPriv"]}},

            {"name": "snmpv3_priv_protocol", "kind": "select", "default": "AES-128",
             "options": ["DES", "3DES", "AES-128", "AES-192", "AES-256"],
             "show_when": {"version": ["3"], "snmpv3_level": ["authPriv"]}},
            {"name": "snmpv3_priv_key", "kind": "password", "secret": true,
             "show_when": {"version": ["3"], "snmpv3_level": ["authPriv"]}},

            {"name": "snmpv3_context", "kind": "text",
             "show_when": {"version": ["3"]}},
            {"name": "snmpv3_engine_id", "kind": "text",
             "show_when": {"version": ["3"]}}
        ]
    },
    "servers": {
        "__new_item_fields__": ["host", "community"],
        "__field_order__": ["enabled", "host", "port", "timeout", "retries", "version", "community", "snmpv3_username", "snmpv3_auth_key", "snmpv3_priv_key", "snmpv3_auth_protocol", "snmpv3_priv_protocol", "device_profiles", "checks"],
        "enabled":              {"type": "bool", "default": true},
        "host":                 {"type": "str",  "default": "", "placeholder": "192.168.1.1", "group": "connection"},
        "port":                 {"type": "int",  "default": 161,   "min": 1,  "max": 65535, "group": "connection"},
        "version":              {"type": "str",  "default": "2c",  "options": ["1", "2c", "3"], "group": "auth"},
        "community":            {"type": "str",  "default": "public", "secret": true, "show_when": {"version": ["1", "2c"]}, "group": "auth"},
        "timeout":              {"type": "int",  "default": 5,     "min": 0, "inherit_blank": true,  "max": 60, "group": "connection"},
        "retries":              {"type": "int",  "default": 1,     "min": 0,  "max": 10, "group": "connection"},
        "snmpv3_username":      {"type": "str",  "default": "",    "show_when": {"version": ["3"]}, "group": "auth"},
        "snmpv3_auth_key":      {"type": "str",  "default": "",    "secret": true, "show_when": {"version": ["3"]}, "group": "auth"},
        "snmpv3_priv_key":      {"type": "str",  "default": "",    "secret": true, "show_when": {"version": ["3"]}, "group": "auth"},
        "snmpv3_auth_protocol": {"type": "str",  "default": "MD5", "options": ["MD5", "SHA", "SHA-224", "SHA-256", "SHA-384", "SHA-512", "none"], "show_when": {"version": ["3"]}, "group": "auth"},
        "snmpv3_priv_protocol": {"type": "str",  "default": "DES", "options": ["DES", "3DES", "AES-128", "AES-192", "AES-256", "none"],          "show_when": {"version": ["3"]}, "group": "auth"},
        "device_profiles":      {"type": "str",  "default": "", "multi": true, "group": "device"},
        "checks": {
            "type":                 "sub_collection",
            "__discovery__":        "discover",
            "__discovery_method__": "POST",
            "__discovery_field__":  "oid",
            "__key_mirrors_field__": "oid",
            "__new_item_fields__":  ["oid"],
            "__discovery_subtitle__":         "{mib_module}::{mib_name}",
            "__discovery_type_field__":       "mib_type",
            "__discovery_category_field__":   "mib_category",
            "__discovery_type_store_field__": "snmp_type",
            "__discovery_categories__": {
                "numeric": {"icon": "bi-hash",      "color": "#38bdf8"},
                "string":  {"icon": "bi-fonts",     "color": "#4ade80"},
                "ip":      {"icon": "bi-globe2",    "color": "#818cf8"},
                "oid":     {"icon": "bi-diagram-2", "color": "var(--bs-secondary-color)"}
            },
            "__discovery_default_operators__": {
                "numeric": "any",
                "string":  "contains",
                "ip":      "eq",
                "oid":     "eq"
            },
            "enabled":   {"type": "bool", "default": true},
            "oid":       {"type": "str",  "default": "1.3.6.1.2.1.1.1.0", "readonly": true},
            "snmp_type": {"type": "str",  "default": "", "hidden": true},
            "operator":  {"type": "str",  "default": "any", "options": ["any", "eq", "ne", "gt", "lt", "gte", "lte", "contains", "regex"]},
            "value":     {"type": "str",  "default": ""},
            "alert":     {"type": "int",  "default": 1, "inherit_blank": true, "min": 1, "max": 100}
        }
    }
}
