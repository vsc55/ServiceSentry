{
    "id": "icmp_stats",
    "label": {
        "en_EN": "ICMP statistics (ICMP-MIB)",
        "es_ES": "Estadísticas ICMP (ICMP-MIB)"
    },
    "description": {
        "en_EN": "Echoes, unreachables and time exceededs, in and out. It is where a network tells you it is complaining before anything reports as down.",
        "es_ES": "Ecos, inalcanzables y TTL agotado, de entrada y de salida. Es donde una red avisa de que se está quejando antes de que nada aparezca como caído."
    },
