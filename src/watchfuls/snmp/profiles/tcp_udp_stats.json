{
    "id": "tcp_udp_stats",
    "label": {
        "en_EN": "TCP and UDP (TCP-MIB, UDP-MIB)",
        "es_ES": "TCP y UDP (TCP-MIB, UDP-MIB)"
    },
    "description": {
        "en_EN": "Established connections, retransmissions, resets and datagrams to closed ports. Retransmissions are the number that says a link is bad long before it is down.",
        "es_ES": "Conexiones establecidas, retransmisiones, resets y datagramas a puertos cerrados. Las retransmisiones son el número que dice que un enlace va mal mucho antes de que esté caído."
    },
    "match": {
        "probe": "1.3.6.1.2.1.6.10.0"
    },
    "metrics": [
        {
            "key": "tcp_estab",
            "label": {"en_EN": "Established connections", "es_ES": "Conexiones establecidas"},
            "oid": "1.3.6.1.2.1.6.9.0",
            "kind": "gauge",
            "unit": "conn"
        },
        {
            "key": "tcp_in_segs",
            "label": {"en_EN": "Segments received", "es_ES": "Segmentos recibidos"},
