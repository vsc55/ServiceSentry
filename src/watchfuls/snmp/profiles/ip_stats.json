{
    "id": "ip_stats",
    "label": {
        "en_EN": "IP statistics (IP-MIB)",
        "es_ES": "Estadísticas IP (IP-MIB)"
    },
    "description": {
        "en_EN": "What the IP layer did with the packets: delivered, forwarded, discarded, fragmented. The interface counters say how much traffic there was; these say what happened to it.",
        "es_ES": "Qué hizo la capa IP con los paquetes: entregados, reenviados, descartados, fragmentados. Los contadores de interfaz dicen cuánto tráfico hubo; éstos dicen qué pasó con él."
    },
    "match": {
