{
    "id": "synology_ups",
    "label": {
        "en_EN": "Synology — UPS (SYNOLOGY-UPS-MIB)",
        "es_ES": "Synology — SAI (SYNOLOGY-UPS-MIB)"
    },
    "description": {
        "en_EN": "The UPS attached to the DiskStation: charge, runtime left, load, voltage and temperature. Runtime is the one number that says how long there is to act, and it is the one nobody looks at until the lights go out.",
        "es_ES": "El SAI conectado al DiskStation: carga, autonomía restante, consumo, voltaje y temperatura. La autonomía es el único número que dice cuánto tiempo hay para reaccionar, y es el que nadie mira hasta que se va la luz."
    },
    "match": {
        "sysobjectid_prefix": "1.3.6.1.4.1.6574",
        "probe": "1.3.6.1.4.1.6574.4.2.1.0"
    },
