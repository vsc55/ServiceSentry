        },
        {
            "key": "swap_avail",
            "oid": "1.3.6.1.4.1.2021.4.4.0",
            "kind": "gauge",
            "unit": "B",
            "scale": 1024,
            "chart": "area",
            "label": {
                "en_EN": "Swap available",
                "es_ES": "Swap disponible"
            }
