{
    "id": "ucd_linux",
    "label": {
        "en_EN": "Linux / BSD (net-snmp)",
        "es_ES": "Linux / BSD (net-snmp)"
    },
    "description": {
        "en_EN": "CPU, load and memory as UCD-SNMP-MIB serves them — the agent on most Linux and BSD machines, and on a good number of NAS boxes, which run one underneath.",
        "es_ES": "CPU, carga y memoria tal como los sirve UCD-SNMP-MIB — el agente de casi cualquier Linux o BSD, y de bastantes NAS, que llevan uno por debajo."
    },
    "match": {
        "sysobjectid_prefix": "1.3.6.1.4.1.8072",
        "probe": "1.3.6.1.4.1.2021.11.9.0"
    },
    "metrics": [
        {
            "key": "cpu_user",
            "oid": "1.3.6.1.4.1.2021.11.9.0",
            "kind": "gauge",
            "unit": "%",
            "chart": "area",
            "label": {
                "en_EN": "CPU user",
                "es_ES": "CPU usuario"
            }
        },
        {
            "key": "cpu_system",
            "oid": "1.3.6.1.4.1.2021.11.10.0",
            "kind": "gauge",
            "unit": "%",
            "chart": "area",
            "label": {
                "en_EN": "CPU system",
                "es_ES": "CPU sistema"
            }
        },
        {
            "key": "cpu_idle",
            "oid": "1.3.6.1.4.1.2021.11.11.0",
            "kind": "gauge",
            "unit": "%",
            "chart": "line",
            "label": {
                "en_EN": "CPU idle",
                "es_ES": "CPU inactiva"
            }
        },
        {
            "key": "load_1",
            "oid": "1.3.6.1.4.1.2021.10.1.5.1",
            "kind": "gauge",
            "unit": "",
            "scale": 0.01,
            "chart": "line",
            "label": {
                "en_EN": "Load (1 min)",
                "es_ES": "Carga (1 min)"
            }
        },
        {
            "key": "load_5",
            "oid": "1.3.6.1.4.1.2021.10.1.5.2",
            "kind": "gauge",
            "unit": "",
            "scale": 0.01,
            "chart": "line",
            "label": {
                "en_EN": "Load (5 min)",
                "es_ES": "Carga (5 min)"
            }
        },
        {
            "key": "load_15",
            "oid": "1.3.6.1.4.1.2021.10.1.5.3",
            "kind": "gauge",
            "unit": "",
            "scale": 0.01,
            "chart": "line",
            "label": {
                "en_EN": "Load (15 min)",
                "es_ES": "Carga (15 min)"
            }
        },
        {
            "key": "mem_total",
            "oid": "1.3.6.1.4.1.2021.4.5.0",
            "kind": "gauge",
            "unit": "B",
            "scale": 1024,
            "chart": "value",
            "label": {
                "en_EN": "Memory total",
                "es_ES": "Memoria total"
            }
        },
        {
            "key": "mem_avail",
            "oid": "1.3.6.1.4.1.2021.4.6.0",
            "kind": "gauge",
            "unit": "B",
            "scale": 1024,
            "chart": "area",
            "label": {
                "en_EN": "Memory available",
                "es_ES": "Memoria disponible"
            }
        },
        {
            "key": "swap_total",
            "oid": "1.3.6.1.4.1.2021.4.3.0",
            "kind": "gauge",
            "unit": "B",
            "scale": 1024,
            "chart": "value",
            "label": {
                "en_EN": "Swap total",
                "es_ES": "Swap total"
