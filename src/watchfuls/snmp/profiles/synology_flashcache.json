            "width": 64,
            "index_label": "1.3.6.1.4.1.6574.103.1.1.3"
        },
        {
            "key": "syno_cache_disk_read",
            "label": {
                "en_EN": "Read from disk",
                "es_ES": "Lectura desde disco"
            },
            "kind": "counter",
            "walk": "1.3.6.1.4.1.6574.103.1.1.6",
            "unit": "op/s",
            "width": 64,
            "index_label": "1.3.6.1.4.1.6574.103.1.1.3"
        },
        {
            "key": "syno_cache_disk_write",
            "label": {
                "en_EN": "Written to disk",
                "es_ES": "Escritura a disco"
            },
            "kind": "counter",
            "walk": "1.3.6.1.4.1.6574.103.1.1.7",
            "unit": "op/s",
            "width": 64,
