{
    "id": "synology_flashcache",
    "label": {
        "en_EN": "Synology — SSD cache (SYNOLOGY-FLASHCACHE-MIB)",
        "es_ES": "Synology — caché SSD (SYNOLOGY-FLASHCACHE-MIB)"
    },
    "description": {
        "en_EN": "Hit rates and traffic of the SSD read/write cache, per cached volume. The hit rate is the number that says whether the cache is earning its disks — a low one means the working set never fitted.",
        "es_ES": "Tasas de acierto y tráfico de la caché SSD de lectura/escritura, por volumen cacheado. La tasa de acierto es el número que dice si la caché se está ganando sus discos: una baja significa que el conjunto de trabajo nunca cupo."
    },
    "match": {
        "sysobjectid_prefix": "1.3.6.1.4.1.6574",
        "probe": "1.3.6.1.4.1.6574.103.1.1.1.0"
    },
    "metrics": [
        {
            "key": "syno_cache_read_hit_rate",
            "label": {
                "en_EN": "Read hit rate",
                "es_ES": "Aciertos de lectura"
            },
            "kind": "gauge",
            "walk": "1.3.6.1.4.1.6574.103.1.1.10",
            "unit": "%",
            "chart": "line",
            "index_label": "1.3.6.1.4.1.6574.103.1.1.3"
        },
        {
            "key": "syno_cache_write_hit_rate",
            "label": {
                "en_EN": "Write hit rate",
                "es_ES": "Aciertos de escritura"
            },
            "kind": "gauge",
            "walk": "1.3.6.1.4.1.6574.103.1.1.11",
            "unit": "%",
            "chart": "line",
            "index_label": "1.3.6.1.4.1.6574.103.1.1.3"
        },
        {
            "key": "syno_cache_read_hits",
            "label": {
                "en_EN": "Read hits",
                "es_ES": "Aciertos de lectura (ops)"
            },
            "kind": "counter",
            "walk": "1.3.6.1.4.1.6574.103.1.1.4",
            "unit": "op/s",
            "width": 64,
            "index_label": "1.3.6.1.4.1.6574.103.1.1.3"
        },
        {
            "key": "syno_cache_write_hits",
            "label": {
                "en_EN": "Write hits",
                "es_ES": "Aciertos de escritura (ops)"
            },
            "kind": "counter",
            "walk": "1.3.6.1.4.1.6574.103.1.1.5",
