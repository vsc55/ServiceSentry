{
    "__icon__": "bi-microsoft",
    "__overview_widget__": [
        {"id": "health", "view": "stat", "icon": "bi-microsoft", "perm": "modules_view",
         "scope": "health", "link": "https://admin.microsoft.com/#/servicehealth"},
        {"id": "table", "view": "table", "icon": "bi-microsoft", "perm": "modules_view",
         "selector": true, "multi": true, "cols": 4, "h": 340}
    ],
    "__page__": {
        "id": "m365", "icon": "bi-microsoft", "order": 40,
        "refresh": "page_refresh", "perm": "modules_view",
        "views": [
            {"slug": "status", "icon": "bi-activity", "label": "view_status"},
            {"slug": "storage", "icon": "bi-hdd-fill", "label": "view_storage",
             "kind": "table", "action": "storage_report"}
        ]
    },
    "__module__": {
        "api_ver": "v1",
        "enabled": {"type": "bool", "default": true},
        "threads": {"type": "int",  "default": 5,  "min": 0, "inherit_blank": true, "max": 100},
        "alert":   {"type": "int",  "default": 3,  "inherit_blank": true, "min": 1, "max": 20},
        "timeout": {"type": "int",  "default": 15, "min": 0, "inherit_blank": true, "max": 300},
        "site_usage_pct": {"type": "int", "default": 90, "min": 0, "inherit_blank": true, "max": 100},
        "site_free_min":  {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999, "unit_field": "site_free_unit"},
        "site_free_unit": {"type": "str", "default": "GB", "options": ["MB", "GB", "TB"]},
        "tenant_pct": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 100},
        "tenant_warn_at": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999, "unit_field": "tenant_warn_unit"},
        "tenant_warn_unit": {"type": "str", "default": "GB", "options": ["MB", "GB", "TB"]},
        "tenant_free_min": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999, "unit_field": "tenant_free_unit"},
        "tenant_free_unit": {"type": "str", "default": "GB", "options": ["MB", "GB", "TB"]},
        "licenses_free_min": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999},
        "secret_expiry_days": {"type": "int", "default": 30, "min": 1, "inherit_blank": true, "max": 3650},
        "mailbox_over_max": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999},
        "onedrive_max": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999, "unit_field": "onedrive_unit"},
        "onedrive_unit": {"type": "str", "default": "TB", "options": ["GB", "TB"]},
        "secure_score_min": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 100},
        "risky_users_max": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 9999999},
        "mfa_coverage_min": {"type": "int", "default": 0,  "min": 0, "inherit_blank": true, "max": 100},
        "unused_after_days": {"type": "int", "default": 60, "min": 1, "inherit_blank": true, "max": 3650},
        "global_admins_max": {"type": "int", "default": 5,   "min": 0, "inherit_blank": true, "max": 999},
        "announce_before_days": {"type": "int", "default": 14, "min": 1, "inherit_blank": true, "max": 365},
        "sites_top":     {"type": "int", "default": 25, "inherit_blank": true, "min": 0, "max": 500},
        "accounts_top":  {"type": "int", "default": 25, "inherit_blank": true, "min": 0, "max": 500},
        "breakdown_page": {"type": "int", "default": 25, "inherit_blank": true, "min": 5, "max": 200}
    },
    "__history__": {"field": "used", "unit": "%", "label": "Microsoft 365"},
    "__status_render__": [{"type": "bar", "value": "used", "threshold": "alert", "default_threshold": 100, "unit": "%"}],
    "__entraid_provision__": {
        "app_roles": ["Sites.Read.All", "Reports.Read.All", "ServiceHealth.Read.All",
                      "Organization.Read.All", "Application.Read.All",
                      "SecurityEvents.Read.All", "IdentityRiskyUser.Read.All",
                      "AuditLog.Read.All", "User.Read.All",
                      "RoleManagement.Read.Directory", "Domain.Read.All",
                      "ServiceMessage.Read.All", "SharePointTenantSettings.Read.All"],
        "app_name": "ServiceSentry M365 Monitor"
    },
    "__credential__": {
        "type": "m365_app",
        "fields": [
            {"name": "tenant_id",     "kind": "text",     "label": "tenant_id"},
            {"name": "client_id",     "kind": "text",     "label": "client_id"},
            {"name": "client_secret", "kind": "password", "secret": true, "label": "client_secret"}
        ],
        "actions": [
            {
                "id": "provision_app",
                "label": "prov_entraid_action_provision_app",
                "url": "/api/v1/auth/entraid/provision/device-code",
                "icon": "bi-microsoft",
                "result": "device_code",
                "provision": {"profile": "m365"}
            },
            {
                "id": "rotate_secret",
                "label": "prov_entraid_action_rotate_secret",
                "url": "/api/v1/auth/entraid/cred/secret/device-code",
                "poll_url": "/api/v1/auth/entraid/cred/secret/device-poll",
                "icon": "bi-arrow-repeat",
                "result": "device_code",
                "intro_key": "prov_entraid_rotate_secret_intro",
                "existing_app": true
            },
            {
                "id": "test_permissions",
                "label": "prov_entraid_action_test_permissions",
                "url": "/api/v1/auth/entraid/check-permissions",
                "icon": "bi-shield-check",
                "result": "modal",
                "provision": {"profile": "m365"}
            },
            {
                "id": "fix_permissions",
                "label": "prov_entraid_action_fix_permissions",
                "url": "/api/v1/auth/entraid/provision/device-code",
                "icon": "bi-shield-plus",
                "result": "device_code",
                "toolbar": false,
                "provision": {"profile": "m365", "ensure": true}
            }
        ],
        "links": [
            {
                "id": "open_app",
                "label": "prov_entraid_action_open_app",
                "icon": "bi-box-arrow-up-right",
                "url": "https://entra.microsoft.com/#view/Microsoft_AAD_RegisteredApps/ApplicationMenuBlade/~/Overview/appId/{client_id}",
                "require": ["client_id"]
            }
        ]
    },
    "list": {
        "__check_title_field__": "label",
        "__title_editable__": true,
        "__new_item_fields__": ["label"],
        "__field_order__": [
            "enabled", "label",
            "tenant_id", "client_id", "client_secret", "timeout",
            "check_site", "site",
            "check_tenant_usage", "tenant_capacity", "tenant_capacity_unit",
            "check_health", "health_services",
            "check_licenses",
            "check_secrets",
            "check_mailbox",
            "check_onedrive",
            "check_secure_score",
            "check_risky_users",
            "check_mfa",
            "check_unused_licenses", "unused_after_days",
            "check_privileged",
            "check_domains",
            "check_announcements",
            "site_usage_pct", "site_free_min", "site_free_unit",
            "tenant_pct", "tenant_warn_at", "tenant_warn_unit",
            "tenant_free_min", "tenant_free_unit",
            "licenses_free_min", "secret_expiry_days", "mailbox_over_max",
            "onedrive_max", "onedrive_unit", "secure_score_min", "risky_users_max", "mfa_coverage_min",
            "global_admins_max", "announce_before_days", "alert",
            "sites_top", "accounts_top"
        ],
        "__test__": "/api/v1/modules/watchfuls/m365/test_connection",
        "__multicheck__": [
            {"toggle": "check_site",            "suffix": "site"},
            {"toggle": "check_tenant_usage",    "suffix": "tenant"},
            {"toggle": "check_health",          "suffix": "health"},
            {"toggle": "check_licenses",        "suffix": "licenses"},
            {"toggle": "check_secrets",         "suffix": "secrets"},
            {"toggle": "check_mailbox",         "suffix": "mailbox"},
            {"toggle": "check_onedrive",        "suffix": "onedrive"},
            {"toggle": "check_secure_score",    "suffix": "securescore"},
            {"toggle": "check_risky_users",     "suffix": "risky"},
            {"toggle": "check_mfa",             "suffix": "mfa"},
            {"toggle": "check_unused_licenses", "suffix": "unused"},
            {"toggle": "check_privileged",      "suffix": "privileged"},
            {"toggle": "check_domains",         "suffix": "domains"},
            {"toggle": "check_announcements",   "suffix": "announcements"}
        ],
        "__discovery_field__": "site",
        "__discovery_field_action__": "list_sites",
        "__discovery_method__": "POST",
        "__discovery_type_field__": "kind",
        "__discovery_allow_none__": true,
        "__actions__": [
            {
                "id": "provision_app",
                "label": "prov_entraid_action_provision_app",
                "open_credential_action": true,
                "icon": "bi-microsoft",
                "variant": "secondary",
                "full_width": true,
                "hide_when_cred_bound": true,
                "group": "auth"
            }
        ],

        "enabled":      {"type": "bool", "default": true},
        "label":        {"type": "str",  "default": ""},

        "tenant_id":     {"type": "str", "default": "", "placeholder": "contoso.onmicrosoft.com", "group": "auth"},
        "client_id":     {"type": "str", "default": "", "placeholder": "00000000-0000-0000-0000-000000000000", "group": "auth"},
        "client_secret": {"type": "str", "default": "", "sensitive": true, "group": "auth"},
        "timeout":       {"type": "int", "default": 0, "min": 0, "max": 300,
                          "zero_as_blank": true, "placeholder_module": "timeout", "group": "auth"},

        "check_site":    {"type": "bool", "default": true, "group": "checks"},
        "site":          {"type": "str",  "default": "", "placeholder": "contoso.sharepoint.com/sites/Marketing",
                          "show_when": {"check_site": [true]}, "group": "checks"},
        "site_usage_pct":     {"type": "int",  "default": 0, "min": 0, "max": 100, "zero_as_blank": true,
                          "placeholder_module": "site_usage_pct", "show_when": {"check_site": [true]}, "group": "alerts"},
        "site_free_min":      {"type": "int",  "default": 0, "min": 0, "max": 9999999, "zero_as_blank": true,
                          "placeholder_module": "site_free_min", "unit_field": "site_free_unit", "show_when": {"check_site": [true]}, "group": "alerts"},
        "site_free_unit":     {"type": "str",  "default": "GB", "options": ["MB", "GB", "TB"],
                          "show_when": {"check_site": [true]}, "group": "alerts"},

        "check_tenant_usage": {"type": "bool", "default": false, "group": "checks"},
        "tenant_capacity":    {"type": "int",  "default": 0, "min": 0, "max": 9999999,
                          "zero_as_blank": true,
                          "unit_field": "tenant_capacity_unit", "show_when": {"check_tenant_usage": [true]}, "group": "checks"},
        "tenant_capacity_unit":   {"type": "str",  "default": "TB", "options": ["GB", "TB"],
                          "show_when": {"check_tenant_usage": [true]}, "group": "checks"},
        "tenant_pct":    {"type": "int",  "default": 90, "min": 0, "max": 100,
                          "zero_as_blank": true,
                          "placeholder_module": "tenant_pct", "show_when": {"check_tenant_usage": [true]}, "group": "alerts"},
        "tenant_warn_at": {"type": "int", "default": 0, "min": 0, "max": 9999999,
                          "zero_as_blank": true,
                          "placeholder_module": "tenant_warn_at", "unit_field": "tenant_warn_unit", "show_when": {"check_tenant_usage": [true]}, "group": "alerts"},
        "tenant_warn_unit": {"type": "str", "default": "GB", "options": ["MB", "GB", "TB"],
                          "placeholder_module": "tenant_warn_unit", "show_when": {"check_tenant_usage": [true]}, "group": "alerts"},
        "tenant_free_min": {"type": "int", "default": 0, "min": 0, "max": 9999999,
                          "zero_as_blank": true,
                          "placeholder_module": "tenant_free_min", "unit_field": "tenant_free_unit", "show_when": {"check_tenant_usage": [true]}, "group": "alerts"},
        "tenant_free_unit": {"type": "str", "default": "GB", "options": ["MB", "GB", "TB"],
                          "placeholder_module": "tenant_free_unit", "show_when": {"check_tenant_usage": [true]}, "group": "alerts"},
        "sites_top":     {"type": "int",  "default": null, "min": 0, "max": 500,
                          "inherit_blank": true,
                          "placeholder_module": "sites_top", "show_when": {"check_tenant_usage": [true]}, "group": "data"},

        "check_health":  {"type": "bool", "default": false, "group": "checks"},
        "health_services": {"type": "str", "default": "", "placeholder": "Exchange Online, Microsoft Teams",
                          "show_when": {"check_health": [true]}, "group": "checks",
                          "input_action": {
                              "id":           "list_services",
                              "url":          "/api/v1/modules/watchfuls/m365/list_services",
                              "icon":         "bi-search",
                              "result":       "field_picker",
                              "result_field": "health_services",
                              "result_multi": true
                          }},

        "check_licenses": {"type": "bool", "default": false, "group": "checks"},
        "licenses_free_min":   {"type": "int",  "default": 0, "min": 0, "max": 9999999,
                          "placeholder_module": "licenses_free_min", "show_when": {"check_licenses": [true]}, "group": "alerts"},

        "check_secrets": {"type": "bool", "default": false, "group": "checks"},
        "secret_expiry_days":   {"type": "int",  "default": 30, "min": 1, "max": 3650,
                          "placeholder_module": "secret_expiry_days", "show_when": {"check_secrets": [true]}, "group": "alerts"},

        "check_mailbox": {"type": "bool", "default": false, "group": "checks"},
        "mailbox_over_max": {"type": "int", "default": 0, "min": 0, "max": 9999999,
                          "placeholder_module": "mailbox_over_max", "show_when": {"check_mailbox": [true]}, "group": "alerts"},

        "check_onedrive": {"type": "bool", "default": false, "group": "checks"},
        "onedrive_max":  {"type": "int",  "default": 0, "min": 0, "max": 9999999,
                          "placeholder_module": "onedrive_max", "unit_field": "onedrive_unit", "show_when": {"check_onedrive": [true]}, "group": "alerts"},
        "onedrive_unit": {"type": "str",  "default": "TB", "options": ["GB", "TB"],
                          "placeholder_module": "onedrive_unit", "show_when": {"check_onedrive": [true]}, "group": "alerts"},
        "accounts_top":  {"type": "int",  "default": null, "min": 0, "max": 500,
                          "inherit_blank": true,
                          "placeholder_module": "accounts_top", "show_when": {"check_onedrive": [true]}, "group": "data"},

        "check_secure_score": {"type": "bool", "default": false, "group": "checks"},
        "secure_score_min":    {"type": "int",  "default": 0, "min": 0, "max": 100,
                          "placeholder_module": "secure_score_min", "show_when": {"check_secure_score": [true]}, "group": "alerts"},

        "check_risky_users": {"type": "bool", "default": false, "group": "checks"},
        "risky_users_max":     {"type": "int",  "default": 0, "min": 0, "max": 9999999,
                          "placeholder_module": "risky_users_max", "show_when": {"check_risky_users": [true]}, "group": "alerts"},

        "check_mfa":     {"type": "bool", "default": false, "group": "checks"},
        "mfa_coverage_min":       {"type": "int",  "default": 90, "min": 0, "max": 100,
                          "placeholder_module": "mfa_coverage_min", "show_when": {"check_mfa": [true]}, "group": "alerts"},

        "check_unused_licenses": {"type": "bool", "default": false, "group": "checks"},
        "unused_after_days":   {"type": "int",  "default": 60, "min": 1, "max": 3650,
                          "placeholder_module": "unused_after_days", "show_when": {"check_unused_licenses": [true]}, "group": "checks"},

        "check_privileged": {"type": "bool", "default": false, "group": "checks"},
        "global_admins_max": {"type": "int",  "default": 5, "min": 0, "max": 999,
                          "placeholder_module": "global_admins_max", "show_when": {"check_privileged": [true]}, "group": "alerts"},

        "check_domains": {"type": "bool", "default": false, "group": "checks"},

        "check_announcements": {"type": "bool", "default": false, "group": "checks"},
        "announce_before_days": {"type": "int",  "default": 14, "min": 1, "max": 365,
                          "placeholder_module": "announce_before_days", "show_when": {"check_announcements": [true]}, "group": "alerts"},

        "alert":         {"type": "int",  "default": 0, "min": 0, "max": 20,
                          "zero_as_blank": true, "placeholder_module": "alert", "group": "alerts"}
    }
}
