# Template — packaging/build.sh substitutes @VERSION@ and writes the real ebuild into the
# overlay tarball attached to the release. Gentoo installs from an ebuild, so that file IS
# the deliverable; `emerge` is what consumes it:
#
#   mkdir -p /var/db/repos/servicesentry
#   tar xzf servicesentry-@VERSION@-gentoo-overlay.tar.gz -C /var/db/repos/servicesentry
#   # add it to /etc/portage/repos.conf, then:
#   emerge app-admin/servicesentry

EAPI=8

DESCRIPTION="Self-hosted monitoring panel with a web admin, scheduler and syslog receiver"
HOMEPAGE="https://github.com/vsc55/ServiceSentry"
SRC_URI="https://github.com/vsc55/ServiceSentry/archive/refs/tags/v@VERSION@.tar.gz -> ${P}.tar.gz"
S="${WORKDIR}/ServiceSentry-@VERSION@"

LICENSE="GPL-3"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

# Only the interpreter and what it takes to build a wheel with no binary for this platform.
# The 41 pinned libraries are installed into a venv by pkg_postinst, from the lock this
# package ships — same reason as the deb/rpm: mapping them to Portage atoms would either
# lose the pins or name packages that do not exist.
#
# acct-user/acct-group come from this same overlay (packaging/gentoo/acct-*.ebuild.in): the
# account always exists, but the services only RUN as it on a fresh install — see
# pkg_postinst.
RDEPEND="
	acct-group/servicesentry
	acct-user/servicesentry
	dev-lang/python:3
	dev-python/pip
"
DEPEND="${RDEPEND}"

src_install() {
	insinto /opt/ServiSesentry
	doins -r src/.
	fperms -R 0755 /opt/ServiSesentry

	# OpenRC, which is what a Gentoo box runs by default.
	doinitd init/openrc/init.d/ServiSesentry
	doinitd init/openrc/init.d/ServiSesentry-web
	# The conf.d files ship the system interpreter; this package runs the venv one. Written
	# here rather than sed'd into /etc by pkg_postinst: an edited conf.d no longer matches
	# what Portage recorded, so every upgrade queued a ._cfg file that, once merged, put the
	# system interpreter back — and the services stopped starting.
	local f
	for f in ServiSesentry ServiSesentry-web; do
		sed 's|^SS_PYTHON=.*|SS_PYTHON="/opt/ServiSesentry/venv/bin/python"|' \
			"init/openrc/conf.d/${f}" > "${T}/${f}.confd" || die
		grep -q '^SS_PYTHON="/opt/ServiSesentry/venv/bin/python"$' "${T}/${f}.confd" \
			|| die "conf.d/${f} did not get the venv interpreter — did SS_PYTHON change?"
		newconfd "${T}/${f}.confd" "${f}"
	done

	# Not keepdir'd: the owner of /var/lib/ServiSesentry is what the OpenRC scripts run the
	# daemon as, and a directory in the image would carry root:root into every merge.
	# pkg_postinst creates them when missing and leaves an existing one's owner alone.

	# The run-as-user helper, and rotation for the SS_LOG files OpenRC writes.
	newsbin packaging/scripts/servicesentry-user.sh servicesentry-user
	insinto /etc/logrotate.d
	newins init/logrotate/servicesentry servicesentry

	dodoc README.md CHANGELOG.md
}

pkg_postinst() {
	local venv="/opt/ServiSesentry/venv"

	einfo "Creating the Python environment in ${venv} (this takes a few minutes)…"
	python3 -m venv "${venv}" || die "could not create the venv"
	"${venv}"/bin/python -m pip install --upgrade pip >/dev/null || die
	"${venv}"/bin/python -m pip install --no-cache-dir \
		-r /opt/ServiSesentry/requirements.lock \
		|| die "could not install the Python dependencies (network? proxy?)"

	local d
	for d in /etc/ServiSesentry /var/lib/ServiSesentry; do
		[[ -d ${d} ]] || install -d -m 0750 "${d}" || die
	done

	# A fresh install runs the services as `servicesentry`; an upgrade keeps whoever they ran
	# as (root, for an install that predates the user) until the operator opts in.
	if [[ -z ${REPLACING_VERSIONS} ]]; then
		sh /usr/sbin/servicesentry-user enable --no-restart \
			|| ewarn "could not hand the data to servicesentry; the services run as root"
	else
		elog "The services keep running as the owner of /var/lib/ServiSesentry. To run them"
		elog "as the dedicated user:  servicesentry-user enable"
	fi

	elog "Start it with:"
	elog "    rc-update add ServiSesentry-web default && rc-service ServiSesentry-web start"
	elog "    rc-update add ServiSesentry default     && rc-service ServiSesentry start"
}

pkg_postrm() {
	# Built by pkg_postinst, so it is ours to remove; config and data are left alone.
	# REPLACED_BY_VERSION, not REPLACING_VERSIONS: this runs in the OLD package's postrm,
	# where only the former is set. REPLACING_VERSIONS is always empty here, so every
	# upgrade deleted the venv the running services use.
	if [[ -z ${REPLACED_BY_VERSION} ]]; then
		rm -rf /opt/ServiSesentry/venv
	fi
}
