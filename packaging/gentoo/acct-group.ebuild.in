# Copied into the overlay by packaging/gentoo/overlay.sh. Version 0, as ::gentoo's acct-*
# packages: the account has no upstream version.

EAPI=8

inherit acct-group

DESCRIPTION="Group for app-admin/servicesentry"
KEYWORDS="~amd64 ~arm64"

# -1: allocated dynamically. A fixed id belongs to ::gentoo's registry, which an overlay
# package is not in.
ACCT_GROUP_ID=-1
