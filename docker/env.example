# ServiceSentry — Docker environment template
# ============================================
# Copy this file to "docker/.env" and edit it. Both compose files load it via
# `env_file: .env`, so your secrets and custom settings stay OUT of the
# (committed) compose files. docker/.env is gitignored.
#
#   cp docker/env.example docker/.env
#   # edit docker/.env  (at minimum change SS_PASSWORD)
#   docker compose -f docker/docker-compose.monolithic.yml up -d
#
# All settings use the SS_ prefix (TZ is the Docker standard, kept as-is).
#
# ┌ SET THESE BEFORE ANYONE CAN REACH IT ───────────────────────────────────────┐
# │ Two kinds of placeholder, and the difference is deliberate:                 │
# │                                                                             │
# │   change-me  a value that WORKS if you leave it. Only where the alternative │
# │              is not starting at all — the panel has to have an admin.       │
# │   (empty)    the stack refuses to start until you fill it in. Preferred:    │
# │              a deployment that will not boot is safer than one running on   │
# │              a password anybody can guess.                                  │
# │                                                                             │
# │   SS_PASSWORD              change-me → the panel's admin login              │
# │   SS_DB_PASSWORD           + SS_DB_ROOT_PASSWORD        empty (microservices)│
# │   SS_SYSLOG_DB_PASSWORD    + SS_SYSLOG_DB_ROOT_PASSWORD empty (microservices)│
# │   SS_CONTROL_TOKEN         empty; set it to enable the instant control poke │
# │   SS_SECRET_KEY            see its own block — LOSING IT LOSES EVERY SECRET │
# │                                                                             │
# │ Each one below carries the command that generates a good value.             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# Notes:
# - Per-topology values live in the compose files, NOT here: SS_SERVICE_ROLE and
#   the *_EMBEDDED gates (the microservices web sets SS_MONITORING_EMBEDDED /
#   SS_SYSLOG_EMBEDDED / SS_EVENTS_EMBEDDED to 0 so dedicated containers own each
#   service; monolithic leaves them on). The web bind/port (SS_WEB_HOST/
#   SS_WEB_PORT) and the published port also stay in compose.
# - SS_WEB_PORT and SS_PORT are not the same thing, and the names hide it: the first
#   is the port THIS process binds (the entrypoint turns it into --web-port), the
#   second locks the port stored in the config, which is what the panel reports about
#   itself. In Docker you want the first one; the second is for an install where the
#   saved value must not be editable from the browser.
# - Empty value = leave the saved config value untouched. Any value set here is
#   applied at runtime and shown read-only (locked) in the web UI.

# ── Credentials (first run creates the initial admin) ─────────────────────────
# Used ONLY on the first run, to create the initial admin; changing it later does
# not change the stored password (do that from the panel).
SS_USERNAME=admin
SS_PASSWORD=change-me          # ← a real password. Anyone who reaches the panel is admin.

# ── Secret key (leave blank to keep the current file-based behaviour) ─────────
# Signs the session cookies AND derives the Fernet key that encrypts every stored
# secret (SSH credentials, API tokens…). Left blank it is generated once into
# .flask_secret inside the config volume, which is fine while a single host keeps
# that volume: the compose files mount it into all four services.
#
# Set it when the file cannot be shared or kept — a pod per role (no shared
# volume), or any deployment where the config volume may be recreated. Every
# process reading the same database MUST hold the same value.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# 64 hex characters; a malformed value stops the process on purpose, because
# starting on a different key than you pinned is how secrets become unreadable
# with nothing reporting an error. LOSING IT LOSES EVERY STORED SECRET — keep a
# copy somewhere other than the machine it runs on.
SS_SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# The monolithic compose uses SQLite (no DB vars needed). The microservices
# compose runs a shared MariaDB and reads these (SS_DB_*): the app processes use
# SS_DB_PASSWORD/NAME/USER, and the db container also provisions itself from them
# (driver/host/port are pinned in that compose file). Required there:
# Generate each of these:  openssl rand -base64 24
SS_DB_PASSWORD=                # app DB password (REQUIRED for microservices)
SS_DB_ROOT_PASSWORD=           # MariaDB root password (REQUIRED for microservices)
SS_DB_NAME=servicesentry
SS_DB_USER=servicesentry
# Advanced / non-compose use: point at an external database directly.
#   SS_DB_DRIVER=mysql         # sqlite | mysql | postgresql  ('mariadb' = alias of mysql)
#   SS_DB_HOST=db
#   SS_DB_PORT=3306
#   SS_DB_PATH=                # SQLite file (driver=sqlite only); empty = the default path

# ── Syslog database (microservices: dedicated DB for syslog messages) ──────────
# The microservices compose runs a SECOND MariaDB (syslog-db) so high-volume
# syslog ingestion stays off the main DB. The syslog + web containers read these
# (SS_SYSLOG_DB_*); the syslog-db container provisions itself from them. Required
# for the microservices topology (driver/host/port are pinned in that compose):
# Generate each of these:  openssl rand -base64 24
SS_SYSLOG_DB_PASSWORD=         # syslog DB password (REQUIRED for microservices)
SS_SYSLOG_DB_ROOT_PASSWORD=    # syslog MariaDB root password (REQUIRED for microservices)
SS_SYSLOG_DB_NAME=servicesentry_syslog
SS_SYSLOG_DB_USER=servicesentry
# Advanced: ENABLED=1 routes syslog to its own DB (set in the microservices
# compose). Leave unset/0 to keep syslog in the main DB (monolithic default).
#   SS_SYSLOG_DB_ENABLED=1
#   SS_SYSLOG_DB_DRIVER=mysql  # sqlite | mysql | postgresql
#   SS_SYSLOG_DB_HOST=syslog-db
#   SS_SYSLOG_DB_PORT=3306
#   SS_SYSLOG_DB_PATH=         # SQLite file for the syslog DB (driver=sqlite only)

# ── Syslog receiver listener (standalone syslog role) ──────────────────────────
# Override where the syslog receiver binds, straight from the environment;
# otherwise the bind host/ports come from the saved config (editable in the web
# UI). SS_SYSLOG_PORT overrides BOTH the UDP and TCP ports (TLS keeps its
# configured port). Empty = use the saved config.
#   SS_SYSLOG_HOST=0.0.0.0
#   SS_SYSLOG_PORT=514
# Whether the EMBEDDED listener comes up with the web admin (default true). A dedicated
# syslog container ignores it: running the listener is that container's whole job.
#   SS_SYSLOG_AUTOSTART=false

# ── Event processor (decoupled notification-rule evaluation) ───────────────────
# Evaluates the event-notification rules (audit/syslog) and dispatches them. It is
# decoupled from ingestion: it reads stored rows by cursor, so a flood of syslog
# never blocks reception. In the microservices topology it runs as its own
# container (SS_SERVICE_ROLE=events) and the web sets SS_EVENTS_EMBEDDED=0 so a
# single worker owns it (both pinned in the compose file). In the monolithic
# topology the web admin hosts it embedded (the default). The rest of its behaviour
# (events|mode = embedded|external|off, poll interval) is configured in the web UI
# → Configuration → Notifications.
#   SS_EVENTS_EMBEDDED=0         # set on the web container in the microservices compose
#   SS_EVENTS_AUTOSTART=false    # whether the EMBEDDED processor starts with the web (default true)

# ── Traefik / public TLS (microservices-traefik topology only) ─────────────────
# Used by docker-compose.microservices-traefik.yml to publish over HTTPS with an
# automatic Let's Encrypt certificate. Point SS_DOMAIN's DNS at this host first.
SS_DOMAIN=                     # public FQDN, e.g. monitor.example.com (REQUIRED for traefik)
SS_ACME_EMAIL=                 # email for Let's Encrypt registration (REQUIRED for traefik)

# ── Appearance / locale ───────────────────────────────────────────────────────
SS_LANG=en_EN
SS_DARK_MODE=false

# ── Monitoring ────────────────────────────────────────────────────────────────
# Scheduler / worker period in seconds (used by the embedded scheduler and the worker).
SS_CHECK_INTERVAL=300
# Whether monitoring is on at all, and whether the EMBEDDED scheduler launches at web
# boot, are normally edited in the web UI (Configuration → Monitoring) and operated from
# the Services tab. Set here they are LOCKED: applied at runtime and shown read-only in
# the panel, which is what you want for a deployment nobody should be able to switch off
# from a browser. In the microservices topology the web container sets
# SS_MONITORING_EMBEDDED=0 (in the compose file) so the dedicated worker owns the
# scheduler; a standalone --monitor worker ignores `autostart` and runs whenever
# monitoring is enabled.
#   SS_MONITORING_EMBEDDED=0     # set on the web container in the microservices compose
#   SS_MONITORING_ENABLED=true   # monitoring on/off        (default true)
#   SS_MONITORING_AUTOSTART=true # embedded scheduler at web boot (default true)

# ── Distributed control plane (microservices only) ─────────────────────────────
# When services run as dedicated containers, the web admin and each service
# coordinate through the SHARED DATABASE (desired state + heartbeat + a command
# queue); a service reconciles on a timer, so control works with no token. Set a
# shared token to ALSO enable the instant HTTP "poke" (POST /control/reconcile),
# so a disable / run-now takes effect immediately instead of at the next poll.
# Use the same token in every container. Empty = poke off (periodic reconcile only).
# Generate with:  openssl rand -hex 32
SS_CONTROL_TOKEN=              # shared bearer token for the control poke (recommended)
#   SS_CONTROL_PORT=8765       # control listener port on worker/syslog/events
#   SS_CONTROL_BIND=0.0.0.0    # address it binds (default 0.0.0.0)
#   SS_CONTROL_ADVERTISE=worker  # address the web pokes (default: the host/pod name)

# ── Security ──────────────────────────────────────────────────────────────────
# The jail that blocks an IP after repeated failed logins. Its state lives in the shared
# database, so every process of the installation enforces the same bans.
#   SS_IPBAN_ENABLED=true      # default true
#   SS_IPBAN_WHITELIST=        # never-banned IPs/CIDRs, comma-separated (e.g. 10.0.0.0/8)
# Who must carry a second factor (TOTP): off | admins | all. Somebody covered by this
# who has none is NOT shut out — they set one up on the way in, which is what makes it
# safe to switch on with nobody signed up yet. Ignored on an install that cannot
# encrypt secrets, since the factor could not be stored.
SS_MFA_REQUIRED=off
# How long a sign-in that owes the code stays parked, in seconds (30..3600). Lower it on a
# shared terminal; raise it where the key lives in a drawer.
#   SS_MFA_HOLD_SECS=300
# The domain security keys are registered against. Empty = derived from SS_PUBLIC_URL.
# Changing it stops every key already registered from working — the browser scopes a
# credential to this value and it cannot be moved.
#   SS_WEBAUTHN_RP_ID=
SS_SECURE_COOKIES=false       # true when serving over HTTPS
SS_REMEMBER_ME_DAYS=30
SS_PROXY_COUNT=0              # number of reverse proxies in front
SS_PUBLIC_URL=               # public host[:port] behind a proxy (empty = derive from the request)
SS_FORCE_HTTPS=false         # redirect HTTP requests to HTTPS
SS_FORCE_FQDN=false          # redirect other hosts to SS_PUBLIC_URL (requires it set)

# ── Public status page ────────────────────────────────────────────────────────
SS_PUBLIC_STATUS=false
SS_PUBLIC_STATUS_DETAIL=false # show per-item detail on the public status page
SS_STATUS_REFRESH_SECS=60
SS_STATUS_LANG=               # defaults to SS_LANG when empty

# ── API tokens ────────────────────────────────────────────────────────────────
# How many recent calls are kept PER TOKEN, so "what has this credential been doing"
# has an answer. A ring, not a log: it never grows with traffic. 0 switches it off,
# for an installation that reads its access log off a proxy.
#   SS_API_TOKEN_LOG_MAX=200

# ── Audit log ─────────────────────────────────────────────────────────────────
SS_AUDIT_MAX_ENTRIES=500
#   SS_AUDIT_DETAIL_MAX_ITEMS=100  # how many fields one entry's detail keeps (default 100)

# ── Backups ───────────────────────────────────────────────────────────────────
# Off until an interval is set. Empty SS_BACKUP_DIR writes to <var_dir>/backups — the
# same disk as the data it copies, which survives a human mistake and nothing else; in
# Docker that is the vardata volume. Point it at a mount that is not this machine and
# the same job starts producing a backup worth the name.
#   SS_BACKUP_DIR=             # where copies are written (empty = <var_dir>/backups)
#   SS_BACKUP_EVERY_HOURS=0    # 0 = no automatic backups. 24 = daily, 168 = weekly
#   SS_BACKUP_KEEP=7           # AUTOMATIC copies kept; 0 = all. Manual ones are never touched
#   SS_BACKUP_AUTO_SECRETS=true  # unattended copies carry the encrypted credentials (default true)

# ── Telegram notifications (secrets — leave blank to disable) ──────────────────
SS_TELEGRAM_TOKEN=
SS_TELEGRAM_CHAT_ID=
SS_TELEGRAM_GROUP_MESSAGES=false

# ── Which published image the test stacks run (read by COMPOSE, not by the app) ─
# The odd one out in this file: everything else here is handed to the process
# inside the container, while this one is substituted into the compose file before
# any container exists — docker/docker-compose.ha-test.yml takes its image tag from
# it for all four services at once.
#
# CI publishes two moving tags: `test` (built beside the suite) and `build` (built
# without running it). Empty/absent = `test`, which the compose file defaults to.
#
# Three places can answer it, and the FIRST one wins:
#   SS_IMAGE_TAG=build docker compose -f docker/docker-compose.ha-test.yml up -d
#   this file, once copied to docker/.env
#   the ${SS_IMAGE_TAG:-test} default written in the compose file
# So a value exported in your shell overrides what you write here — which is worth
# knowing when the stack comes up on an image you did not expect.
#   SS_IMAGE_TAG=build

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Where Diagnostics asks whether a newer release exists. Empty = this repository's
# releases API. A setting and not a constant so a fork, or an install that may only
# reach an internal mirror, points it elsewhere without a code change — and so the one
# address this panel is willing to contact is visible. The check NEVER runs on its own:
# only when somebody presses the button.
#   SS_UPDATE_CHECK_URL=

# ── Web (only when the SAVED port must not be editable from the panel) ─────────
# Not the port this process binds — that is SS_WEB_PORT above. See the note at the top.
#   SS_PORT=8080

# ── Misc ──────────────────────────────────────────────────────────────────────
TZ=UTC
SS_VERBOSE=false              # true forces debug output (any role)
# Log verbosity for any role: off | debug | info | warning | error. Overrides the
# saved config (SS_VERBOSE/-v still forces debug). Empty = use the saved value.
SS_LOG_LEVEL=
