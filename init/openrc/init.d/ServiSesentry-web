#!/sbin/openrc-run
# ServiSesentry web admin panel
# Configuration: /etc/conf.d/ServiSesentry-web

: "${SS_PYTHON:=/usr/bin/python3}"
: "${SS_APP:=/opt/ServiSesentry/main.py}"
command="${SS_PYTHON}"
# No --web-host/--web-port unless conf.d sets them: the panel's own setting
# (Configuration -> External access) decides, and forcing 0.0.0.0 here made it do nothing.
# Exported rather than passed, so the Config UI also shows the field as locked.
command_args="${SS_APP} --web"
if [ -n "${SS_WEB_HOST}" ]; then export SS_WEB_HOST; fi
if [ -n "${SS_WEB_PORT}" ]; then export SS_WEB_PORT; fi
command_background=true
# A backgrounded daemon's stdout/stderr go to /dev/null unless named here, which left
# nothing to read when it would not start. SS_LOG (conf.d) picks the file; set it
# empty to keep the old behaviour. Unbuffered, or the file lags minutes behind.
# shellcheck disable=SC2154  # RC_SVCNAME is set by OpenRC at runtime
: "${SS_LOG=/var/log/${RC_SVCNAME}.log}"
if [ -n "${SS_LOG}" ]; then
	output_log="${SS_LOG}"
	error_log="${SS_LOG}"
fi
export PYTHONUNBUFFERED=1
# Who runs it: SS_USER from conf.d, else the owner of the data dir. A fresh install hands
# /var/lib/ServiSesentry to the `servicesentry` user; one that already existed keeps it as
# root's, and so keeps running as root until `servicesentry-user enable` is run. Following
# the owner (rather than a value written into this file or conf.d) is what lets that choice
# survive upgrades without touching a file Portage protects.
: "${SS_USER:=$(stat -c %U /var/lib/ServiSesentry 2>/dev/null)}"
if [ -n "${SS_USER}" ] && [ "${SS_USER}" != "root" ]; then
	command_user="${SS_USER}"
	# ping's raw ICMP and syslog on :514 — ambient (^), so the Python process keeps them.
	capabilities="^cap_net_raw,^cap_net_bind_service"
fi
# shellcheck disable=SC2154  # RC_SVCNAME is set by OpenRC at runtime
pidfile="/var/run/${RC_SVCNAME}.pid"

depend() {
	use net
	need localmount
}

start_pre() {
	# The venv is bound to the python3.X it was built with; a Python upgrade that removed
	# it leaves an interpreter that does not run. Say so, and how to fix it.
	if ! "${SS_PYTHON}" -c "import sys" >/dev/null 2>&1; then
		eerror "${SS_PYTHON} does not run (was Python upgraded?)."
		eerror "Rebuild the environment as root: sh /opt/ServiSesentry/make-venv.sh"
		return 1
	fi
	# The log is opened for the daemon's user, so it has to be that user's to write.
	if [ -n "${SS_LOG}" ] && [ -n "${command_user}" ]; then
		checkpath -f -m 0640 -o "${command_user}" "${SS_LOG}"
	fi
}
