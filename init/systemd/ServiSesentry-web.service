[Unit]
Description=ServiSesentry web admin panel
After=network.target
Wants=network-online.target

[Service]
Type=simple
# Unbuffered: through a pipe Python block-buffers stdout, and the journal got the output
# minutes late — and lost it altogether when the process was killed.
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ServiSesentry/main.py --web --web-host 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
